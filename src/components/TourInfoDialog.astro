---
// The "More info" panel behind every tour card.
//
// Content is baked into the page as JSON rather than fetched per click: it is roughly 60KB of
// text for the whole catalogue, so the panel opens with no spinner and keeps working if
// TourDesk is unreachable. Run `npm run sync-tours` to refresh it.
//
// Pairs with TourBookingDialog: the "Check dates" button in here carries the same .tc-book
// class, so the booking flow picks it up without this component knowing anything about it.
import data from '../content/tours.generated.json';

interface Props {
  /** Limit the baked-in data to these tour ids. The front page shows three, and has no reason
   *  to carry the text for all twenty-five. Omit to include everything. */
  only?: string[];
}
const { only } = Astro.props;
const included = only ? data.tours.filter((t) => only.includes(t.id)) : data.tours;

// Only what the panel actually renders — the card fields are already on the page.
const payload = Object.fromEntries(
  included.map((t) => [
    t.id,
    {
      title: t.title,
      image: t.image,
      duration: t.duration,
      minimumAge: t.minimumAge,
      minParty: t.minParty,
      pickupService: t.pickupService,
      priceFormatted: t.priceFormatted,
      ...t.info,
    },
  ])
);
---

<script type="application/json" id="tour-info-data" set:html={JSON.stringify(payload)} is:inline />

<dialog class="ti-dialog" id="tdInfo" aria-labelledby="tiTitle">
  <form method="dialog" class="ti-close-form">
    <button class="ti-close" aria-label="Close">&#215;</button>
  </form>

  <img class="ti-hero" alt="Tour photo" hidden />
  <h3 id="tiTitle"></h3>
  <p class="ti-vendor"></p>

  <ul class="ti-facts"></ul>

  <div class="ti-body"></div>

  <div class="ti-gallery" hidden></div>

  <div class="ti-foot">
    <span class="ti-price"></span>
    <button type="button" class="tc-book" data-tour="" data-title="">Check dates</button>
  </div>
</dialog>

<style is:global>
  /* Global for the same reason as the booking dialog: everything below the shell is written
     into the panel by JavaScript at runtime, and Astro's scoped selectors only ever match
     markup that existed at build time. */
  .ti-dialog {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    border: 0;
    border-radius: 16px;
    padding: 0 0 20px;
    color: inherit;
    background: #fff;
    box-shadow: 0 24px 60px rgba(15, 25, 35, 0.25);
  }
  .ti-dialog::backdrop { background: rgba(16, 24, 32, 0.55); }

  .ti-close-form { position: sticky; top: 0; z-index: 2; display: flex; justify-content: flex-end; height: 0; }
  .ti-close {
    border: 0; cursor: pointer; font-size: 22px; line-height: 1;
    width: 34px; height: 34px; margin: 10px 10px 0 0; border-radius: 50%;
    background: rgba(255, 255, 255, 0.9); color: #1d2529;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .ti-hero { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; background: #eceff1; }
  .ti-dialog h3 { font-size: 22px; line-height: 1.3; padding: 18px 22px 0; }
  .ti-vendor { font-size: 13px; color: var(--slate); padding: 4px 22px 0; }

  .ti-facts {
    list-style: none; display: flex; flex-wrap: wrap; gap: 6px;
    margin: 0; padding: 14px 22px 0;
  }
  .ti-facts li {
    font-size: 12px; color: var(--slate);
    background: #f1f4f6; border-radius: 999px; padding: 4px 11px;
  }

  .ti-body { padding: 4px 22px 0; }
  .ti-section { margin-top: 20px; }
  .ti-section h4 {
    font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 600; color: var(--slate); margin-bottom: 7px;
  }
  .ti-section p { font-size: 14px; line-height: 1.6; }
  .ti-section p + p { margin-top: 9px; }
  .ti-section ul { margin: 0; padding-left: 20px; }
  .ti-section li { font-size: 14px; line-height: 1.6; }
  .ti-section strong { font-weight: 600; }

  .ti-gallery {
    display: flex; gap: 8px; overflow-x: auto; padding: 20px 22px 0;
    scrollbar-width: thin;
  }
  .ti-gallery img {
    height: 88px; width: 132px; object-fit: cover; border-radius: 8px; flex: none; background: #eceff1;
  }

  .ti-foot {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 20px 22px 0; margin-top: 20px; border-top: 1px solid #eef1f3;
  }
  .ti-price { font-size: 13px; color: var(--slate); }
  .ti-price strong { font-size: 17px; color: var(--ink, #292d30); display: block; }

  /* The secondary action on each card, beside "Check dates". */
  .tc-info {
    background: transparent;
    color: var(--slate);
    border: 1px solid #d3dae0;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    padding: 9px 15px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tc-info:hover { background: #f1f4f6; border-color: #b9c3ca; }
</style>

<script>
  // Opens the info panel for whichever tour's "More info" was clicked.
  const raw = document.getElementById('tour-info-data');
  const dialog = document.getElementById('tdInfo') as HTMLDialogElement | null;

  if (raw && dialog) {
    const tours = JSON.parse(raw.textContent || '{}');
    const $ = (sel: string) => dialog.querySelector(sel) as HTMLElement;
    const hero = $('.ti-hero') as HTMLImageElement;
    const titleEl = $('#tiTitle');
    const vendorEl = $('.ti-vendor');
    const factsEl = $('.ti-facts');
    const bodyEl = $('.ti-body');
    const galleryEl = $('.ti-gallery');
    const priceEl = $('.ti-price');
    const bookBtn = $('.tc-book') as HTMLButtonElement;

    const section = (heading: string, html: string | null) =>
      html ? `<div class="ti-section"><h4>${heading}</h4>${html}</div>` : '';

    function open(id: string) {
      const t = tours[id];
      if (!t) return;

      if (t.image) {
        hero.src = t.image;
        hero.alt = t.title;
        hero.hidden = false;
      } else {
        hero.hidden = true;
      }

      titleEl.textContent = t.title;
      vendorEl.textContent = t.vendor ? `Operated by ${t.vendor}` : '';
      vendorEl.hidden = !t.vendor;

      const facts = [
        t.duration,
        t.minimumAge > 0 ? `Age ${t.minimumAge}+` : null,
        t.minParty > 1 ? `Minimum ${t.minParty} people` : null,
        t.travelMethod,
        t.pickupService ? 'Pickup available' : null,
      ].filter(Boolean);
      factsEl.innerHTML = facts.map((f) => `<li>${f}</li>`).join('');

      bodyEl.innerHTML =
        section('About this tour', t.description) +
        section('What is included', t.included) +
        section('What to bring', t.requirements) +
        section('Good to know', t.attention) +
        section('Meeting point', t.meetingPoint ? `<p>${t.meetingPoint}</p>` : null) +
        section('Cancellation', t.cancellation);

      // The lead photo is already the hero above; the strip shows the rest.
      const rest = (t.gallery || []).filter((u: string) => u !== t.image).slice(0, 5);
      galleryEl.hidden = rest.length === 0;
      galleryEl.innerHTML = rest
        .map((u: string) => `<img src="${u}" alt="" loading="lazy" decoding="async">`)
        .join('');

      priceEl.innerHTML = t.priceFormatted
        ? `from <strong>${t.priceFormatted}</strong>${t.minParty > 1 ? ' per person' : ''}`
        : '';

      bookBtn.dataset.tour = id;
      bookBtn.dataset.title = t.title;

      dialog.scrollTop = 0;
      dialog.showModal();
    }

    document.querySelectorAll('.tc-info').forEach((btn) =>
      btn.addEventListener('click', () => open((btn as HTMLElement).dataset.tour || ''))
    );

    // Two modals must never be open at once — step aside for the booking dialog, which has its
    // own listener on this same button.
    bookBtn.addEventListener('click', () => dialog.close());
  }
</script>
