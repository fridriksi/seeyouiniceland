---
// The body of a cabin page, shared by the English (/cabins/[slug]) and Icelandic (/is/...)
// versions so both stay one design. Each page works out its own copy and facts and passes them
// in; the photos and the booking widget are the same in both languages.
import BookingWidget from './BookingWidget.astro';
import { responsive } from '../lib/img.js';

interface Fact { label: string; value: string }
interface Nearby { name: string; distance?: string; body: string }
interface Props {
  cabin: any;
  name: string;
  place?: string;
  headline: string;
  intro: string;
  facts: Fact[];
  amenities: string[];
  locationText?: string;
  nearby?: Nearby[];
  /** The same page in the other language. */
  altLang?: { href: string; hreflang: string; label: string };
  labels: {
    mainInfo: string;
    included: string;
    gallery: string;
    photo: string;
    location: string;
    nearby?: string;
    maps: string;
    book: string;
    bookHeading: string;
  };
}

const { cabin, name, place, headline, intro, facts, amenities, locationText, nearby = [], altLang, labels } =
  Astro.props;
---

<section class="hero">
  <div class="shell">
    <div class="hero-frame">
      {cabin.cover && (
        <img
          src={cabin.cover.src}
          alt={cabin.cover.alt || name}
          width={cabin.cover.width}
          height={cabin.cover.height}
          fetchpriority="high"
          {...responsive(cabin.cover, '100vw')}
        />
      )}
      <div class="hero-scrim"></div>
      <!-- The cabin's name alone says nothing about where it is, and the H1 is one of the
           strongest on-page signals for local searches like "cabin Kirkjubæjarklaustur". -->
      <h1>
        {name}
        {place && <span class="h1-place">{place}</span>}
      </h1>
    </div>
  </div>
</section>

<section class="shell intro reveal">
  <div class="intro-copy">
    <p class="eyebrow">{labels.mainInfo}</p>
    <h2>{headline}</h2>
    <div class="prose" set:html={intro} />
    {altLang && (
      <a class="lang-switch" href={altLang.href} hreflang={altLang.hreflang} lang={altLang.hreflang}>
        {altLang.label}
      </a>
    )}
  </div>

  <dl class="facts">
    {facts.map((f) => (
      <div class="fact">
        <dt>{f.label}</dt>
        <dd>{f.value}</dd>
      </div>
    ))}
  </dl>
</section>

{amenities.length > 0 && (
  <section class="shell amenities reveal">
    <p class="eyebrow">{labels.included}</p>
    <ul>
      {amenities.map((a) => <li>{a}</li>)}
    </ul>
  </section>
)}

{cabin.gallery.length > 0 && (
  <section class="shell gallery reveal">
    <p class="eyebrow">{labels.gallery}</p>
    <div class="gallery-grid">
      {cabin.gallery.map((img, i) => (
        <img
          src={img.src}
          alt={img.alt || `${name} — ${labels.photo} ${i + 2}`}
          width={img.width}
          height={img.height}
          loading="lazy"
          {...responsive(img, '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw')}
        />
      ))}
    </div>
  </section>
)}

{locationText && (
  <section class="shell location reveal" id="location">
    <p class="eyebrow">{labels.location}</p>
    <div class="prose" set:html={locationText} />
    {cabin.mapsLink && (
      <a class="maps" href={cabin.mapsLink} target="_blank" rel="noopener">{labels.maps}</a>
    )}
  </section>
)}

{nearby.length > 0 && (
  <section class="shell nearby reveal">
    <p class="eyebrow">{labels.nearby}</p>
    <div class="nearby-list">
      {nearby.map((n) => (
        <div class="nearby-item">
          <h3>{n.name}</h3>
          <p>{n.body}</p>
          <span class="distance">{n.distance}</span>
        </div>
      ))}
    </div>
  </section>
)}

<section class="shell booking reveal" id="book">
  <p class="eyebrow">{labels.book}</p>
  <h2>{labels.bookHeading}</h2>
  <BookingWidget propertyId={cabin.propertyId} />
</section>

<style>
  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--slate);
  }

  .hero { padding-top: 90px; }
  .hero-frame {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    padding: 56px;
  }
  .hero-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }
  .hero h1 {
    position: relative;
    color: var(--ground);
    font-size: clamp(38px, 7vw, 80px);
    max-width: 16ch;
  }
  .h1-place {
    display: block;
    margin-top: 14px;
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    font-weight: 600;
  }

  section { margin-top: 72px; }

  .intro {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 810px) {
    .intro { grid-template-columns: 1.6fr 1fr; align-items: start; gap: 56px; }
  }
  .intro-copy { display: flex; flex-direction: column; gap: 14px; }
  .intro h2 { font-size: clamp(26px, 3.4vw, 40px); }

  .prose { display: flex; flex-direction: column; gap: 14px; font-size: 15px; line-height: 1.6; }
  .prose :global(h3) {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--heading-ink);
    font-weight: 600;
  }
  .prose :global(p) { margin: 0; }

  .facts {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .fact {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .fact dt { font-size: 13px; color: var(--body-ink); }
  .fact dd { margin: 0; font-size: 13px; font-weight: 600; color: var(--heading-ink); text-align: right; }

  .amenities ul {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 8px 24px;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    font-size: 14px;
  }

  .gallery-grid {
    margin-top: 14px;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .gallery-grid img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
  }

  .location { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; max-width: 720px; }
  .maps {
    font-size: 14px;
    font-weight: 600;
    color: var(--slate);
  }

  .booking { display: flex; flex-direction: column; gap: 12px; }
  .booking h2 { font-size: clamp(26px, 3.4vw, 40px); }

  .lang-switch { font-size: 14px; font-weight: 600; color: var(--slate); align-self: flex-start; }

  .nearby-list { margin-top: 14px; display: grid; border-top: 1px solid var(--rule); }
  .nearby-item {
    display: grid;
    gap: 6px 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 810px) {
    .nearby-item { grid-template-columns: 200px 1fr 90px; align-items: start; }
  }
  .nearby-item h3 { font-size: 20px; }
  .nearby-item p { font-size: 14px; line-height: 1.55; }
  .distance { font-size: 13px; font-weight: 600; color: var(--slate); white-space: nowrap; }
  @media (min-width: 810px) { .distance { text-align: right; } }
</style>
